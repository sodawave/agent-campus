{
  "name": "@agent-campus/campus-engine",
  "version": "0.9.0",
  "description": "Pure-TypeScript domain engine for Agent Campus (domain model, org rules, workers, library, store).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./catalog/*": "./src/catalog/*",
    "./layouts/*": "./src/layouts/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
