# Agent Campus production Compose environment.
# Copy to .env and replace every CHANGE_ME. Pattern from block/buzz deploy/compose.

CAMPUS_API_IMAGE=ghcr.io/sodawave/agent-campus-api:main

CAMPUS_DOMAIN=campus.example.com
CAMPUS_WS_URL=wss://campus.example.com/ws
CAMPUS_CORS_ORIGINS=https://campus.example.com

# Agent communication bus: internal (default) or buzz relay URL
CAMPUS_COMMS_BACKEND=internal
CAMPUS_BUZZ_RELAY_URL=

POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD

CAMPUS_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
CAMPUS_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
CAMPUS_S3_BUCKET=campus-library
CAMPUS_S3_ADDRESSING_STYLE=path

MEMPALACE_URL=http://mempalace:8080

CAMPUS_HTTP_PORT=3000
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
