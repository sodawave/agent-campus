{
  "name": "agent-campus",
  "version": "0.9.0",
  "private": true,
  "description": "Gamified campus for AI agent harnesses — headless core + minimal viewer.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server": "npm run start --workspace apps/server",
    "viewer": "npm run dev --workspace apps/viewer",
    "build": "npm run build --workspace apps/viewer",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
