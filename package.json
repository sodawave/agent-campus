{
  "name": "agent-campus",
  "version": "0.9.0",
  "private": true,
  "description": "Gamified campus for AI agent harnesses — core engine (control plane).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @agent-campus/server",
    "dev:viewer": "npm run dev --workspace @agent-campus/viewer",
    "dev:panel": "npm run dev --workspace @agent-campus/control-panel",
    "graphql": "npm run graphql --workspace @agent-campus/api",
    "cli": "npm run campus --workspace @agent-campus/cli --",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace packages/campus-engine",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
