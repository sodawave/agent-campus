{
  "name": "@agent-campus/engine-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Campus control ambient — domain engine + server/api/panel/bridge/cli",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @agent-campus/server",
    "dev:panel": "npm run dev --workspace @agent-campus/control-panel",
    "dev:wa-bridge": "npm run dev --workspace @agent-campus/wa-bridge",
    "mcp:wa": "npm run mcp --workspace @agent-campus/wa-bridge",
    "graphql": "npm run graphql --workspace @agent-campus/api",
    "cli": "npm run campus --workspace @agent-campus/cli --",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace @agent-campus/engine",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
