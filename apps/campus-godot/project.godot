; Agent Campus — Godot presentation client (projection only).
; Engine: Godot 4.3 (GDScript, gl_compatibility renderer for software/headless GPUs).

config_version=5

[application]

config/name="Agent Campus — Godot"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=900
window/size/viewport_height=560

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
